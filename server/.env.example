DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
JWT_SECRET="change-me-in-production"
PORT=8787
CORS_ORIGIN="http://localhost:5173"
# Forgot-password emails. Without RESEND_API_KEY, the reset link is logged to the
# server console instead of emailed — useful for local dev without a Resend account.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Shogi Dojo <onboarding@resend.dev>"
# Base URL used to build the reset-password link. Defaults to CORS_ORIGIN if unset.
APP_URL="http://localhost:5173"
