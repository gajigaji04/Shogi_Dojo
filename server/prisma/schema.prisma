generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nickname     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  gamesAsPlayer1 Game[]       @relation("player1")
  gamesAsPlayer2 Game[]       @relation("player2")
  gamesWon       Game[]       @relation("winner")
  matchQueue     MatchQueue?
}

model Game {
  id         String    @id @default(cuid())
  player1Id  String
  player2Id  String
  winnerId   String?
  status     String // WAITING | PLAYING | FINISHED | ABANDONED
  resultKind String? // checkmate | resign | disconnect | sennichite | perpetual_check
  // Full current GameState (board/hands/currentPlayer/status/winner/isCheck), so a
  // poll can read the live position in one query instead of replaying every move.
  stateJson  Json
  lastMoveAt DateTime  @default(now())
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  createdAt  DateTime  @default(now())

  player1 User       @relation("player1", fields: [player1Id], references: [id])
  player2 User       @relation("player2", fields: [player2Id], references: [id])
  winner  User?      @relation("winner", fields: [winnerId], references: [id])
  moves   GameMove[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([status])
}

model GameMove {
  id         String   @id @default(cuid())
  gameId     String
  moveNumber Int
  playerId   String
  moveData   String // JSON: { move, notation, isCheck, boardAfter, handsAfter, currentPlayerAfter }
  createdAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

/** A single-row-per-user matchmaking waiting list. Replaces the old in-memory queue
 * so matchmaking works across separate, stateless serverless invocations. */
model MatchQueue {
  userId    String   @id
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Notice {
  id          String   @id @default(cuid())
  titleKo     String
  titleJa     String
  titleEn     String
  contentKo   String
  contentJa   String
  contentEn   String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
